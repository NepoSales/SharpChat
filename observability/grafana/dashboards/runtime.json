{
  "uid": "sharpchat-runtime",
  "title": "SharpChat / Runtime",
  "description": ".NET runtime health of each API instance.",
  "tags": [
    "sharpchat"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "sharpchat"
      ],
      "asDropdown": true,
      "title": "SharpChat"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(dotnet_process_cpu_count, instance)",
          "refId": "instance"
        },
        "definition": "label_values(dotnet_process_cpu_count, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Process CPU time divided by the cores available to the container.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(dotnet_process_cpu_time_seconds_total{instance=~\"$instance\"}[$__rate_interval])) / on (instance) max by (instance) (dotnet_process_cpu_count{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
