    {
      "type": "timeseries",
      "title": "Send latency",
      "description": "Only sends that created a message.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
