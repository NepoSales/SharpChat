      }
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Open a line to jump to its trace in Jaeger.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"sharpchat-api\", service_instance_id=~\"$instance\"} | severity_text=~\"Warning|Error|Fatal\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      }
    }
